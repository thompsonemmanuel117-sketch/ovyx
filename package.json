{
  "name": "ovyx-forgeos",
  "version": "1.0.0",
  "private": true,
  "description": "OVYX (ForgeOS) — Cloudflare Pages + Functions application",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "wrangler pages dev .",
    "dev:pages": "wrangler pages dev .",
    "deploy": "wrangler pages deploy .",
    "functions:dev": "wrangler pages dev .",
    "check": "wrangler types",
    "validate": "node scripts/ovyx-static-verify.mjs",
    "build": "node scripts/ovyx-pages-build.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "wrangler": "^4.142.0",
    "@cloudflare/workers-types": "^5.20260926.1"
  },
  "cloudflare": {
    "runtime": "workers",
    "compatibility_flags": [
      "nodejs_compat"
    ]
  }
}
