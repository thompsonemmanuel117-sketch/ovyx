{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ovyx-backend-runtime",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "containers": [
    {
      "class_name": "OvyxBackendSandbox",
      "image": "./Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 12,
      "observability": { "enabled": true }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SANDBOX", "class_name": "OvyxBackendSandbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OvyxBackendSandbox"] }
  ]
}
